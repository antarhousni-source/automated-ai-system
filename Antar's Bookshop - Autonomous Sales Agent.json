    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst customers = {};\nconst thirtyDaysAgo = Date.now() - 1 * 24 * 60 * 60 * 1000;\n\nfor (const item of items) {\n  const email = item.json['Customer Email'];\n  const timestamp = new Date(item.json['Timestamp']).getTime();\n  const request = item.json['Customer Request'];\n\n  if (!customers[email]) {\n    customers[email] = { email, lastSeen: timestamp, requests: [] };\n  }\n  if (timestamp > customers[email].lastSeen) {\n    customers[email].lastSeen = timestamp;\n  }\n  customers[email].requests.push(request);\n}\n\nconst inactive = Object.values(customers)\n  .filter(c => c.lastSeen <= thirtyDaysAgo);\n\nreturn inactive.map(c => ({ json: c }));"
      },
