        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a warm and professional customer engagement specialist for Antar's Bookshop in Saida, Lebanon. Write personalized re-engagement emails that feel genuine, not automated.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.finalPrompt }}\"\n    }\n  ]\n}",
