    {
      "parameters": {
        "jsCode": "const history = $input.all();\nconst current = $('Code').item.json;\n\nconst recent = history\n  .slice(-3)\n  .map(item => parseFloat(item.json['Average Sentiment']))\n  .filter(s => !isNaN(s));\n\nconst trending = recent.length >= 2 \n  ? recent[recent.length-1] < recent[0] ? 'DECLINING' : 'STABLE'\n  : 'INSUFFICIENT_DATA';\n\nreturn [{\n  json: {\n    averageSentiment: current.averageSentiment,\n    totalAnalyzed: current.totalAnalyzed,\n    date: current.date,\n    bookRequestSentiment: current.bookRequestSentiment,\n    complaintSentiment: current.complaintSentiment,\n    generalInquirySentiment: current.generalInquirySentiment,\n    trend: trending,\n    alertNeeded: current.averageSentiment < 6 || trending === 'DECLINING'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "4fe57995-eed6-4c96-923a-47954acf3796",
      "name": "Trend Code"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet total = 0;\nlet count = 0;\n\nfor (const item of items) {\n  const score = parseFloat(item.json.choices[0].message.content.trim());\n  if (!isNaN(score)) {\n    total += score;\n    count++;\n  }\n}\n\nconst average = count > 0 ? (total / count).toFixed(2) : 0;\n\nreturn [{\n  json: {\n    averageSentiment: parseFloat(average),\n    totalAnalyzed: count,\n    date: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        0
      ],
      "id": "9396b7f9-b689-46c2-b1c7-6b0ae1fa7b64",
      "name": "Code"
    }
