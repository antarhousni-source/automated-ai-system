    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst demand = {};\n\nfor (const item of items) {\n  const topic = item.json['Requested Book Topic'];\n  if (topic) {\n    const key = topic.toLowerCase().trim();\n    demand[key] = {\n      topic: topic,\n      count: (demand[key]?.count || 0) + 1\n    };\n  }\n}\n\nconst highDemand = Object.values(demand)\n  .filter(item => item.count >= 2);\n\nreturn highDemand.map(item => ({ json: item }));"
      },
