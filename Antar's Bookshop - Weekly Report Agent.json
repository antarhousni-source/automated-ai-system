    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst total = items.length;\nconst intents = { BOOK_REQUEST: 0, COMPLAINT: 0, GENERAL_INQUIRY: 0 };\nconst topics = {};\n\nfor (const item of items) {\n  const intent = item.json['Intent'];\n  if (intents[intent] !== undefined) intents[intent]++;\n  \n  const request = item.json['Customer Request'];\n  if (request) {\n    topics[request] = (topics[request] || 0) + 1;\n  }\n}\n\nconst topTopic = Object.entries(topics).sort((a,b) => b[1]-a[1])[0];\n\nreturn [{\n  json: {\n    totalInteractions: total,\n    bookRequests: intents.BOOK_REQUEST,\n    complaints: intents.COMPLAINT,\n    generalInquiries: intents.GENERAL_INQUIRY,\n    topRequest: topTopic ? topTopic[0] : 'N/A',\n    topRequestCount: topTopic ? topTopic[1] : 0\n  }\n}];"
      },
